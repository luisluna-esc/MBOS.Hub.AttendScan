# Copiar a /root/attendscan-backend.env en el servidor (chmod 600). NO va a Git con valores reales.
# Si se cambia algo aquí, hay que recrear el contenedor: bash /opt/attendscan/backend/deploy.sh
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=host.docker.internal;Port=5432;Database=attendscan;Username=attendscan;Password=CAMBIAR
# Base64 de 48 bytes al azar:  openssl rand -base64 48
Jwt__Key=CAMBIAR
Cors__AllowedOrigins__0=https://attendscan.iasdmbos.cloud
